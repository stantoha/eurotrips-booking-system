# =============================================================================
# EUROTRIPS — Environment Variables
# Скопіюйте цей файл у .env і заповніть реальними значеннями
# cp .env.example .env
# =============================================================================

# ── APP ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
SITE_URL=https://eurotrips.ua

# ── DATABASE ────────────────────────────────────────────────────────────────
POSTGRES_DB=eurotrips_dev
POSTGRES_USER=eurotrips
POSTGRES_PASSWORD=eurotrips_dev_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eurotrips:eurotrips_dev_pass@localhost:5432/eurotrips_dev?schema=public

# ── REDIS ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pass
REDIS_URL=redis://:redis_dev_pass@localhost:6379

# ── AUTH / JWT ──────────────────────────────────────────────────────────────
# Генерувати: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_SECRET
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=12

# ── pgAdmin ──────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@eurotrips.ua
PGADMIN_PASSWORD=pgadmin_pass
PGADMIN_PORT=5050

# ── EMAIL (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.REPLACE_WITH_REAL_KEY
EMAIL_FROM=noreply@eurotrips.ua
EMAIL_FROM_NAME=Eurotrips

# ── EMAIL (Brevo / резервний) ────────────────────────────────────────────────
BREVO_API_KEY=REPLACE_WITH_REAL_KEY

# ── TELEGRAM ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_WITH_REAL_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_SECRET

# ── VIBER ───────────────────────────────────────────────────────────────────
VIBER_AUTH_TOKEN=REPLACE_WITH_REAL_TOKEN

# ── SMS ─────────────────────────────────────────────────────────────────────
SMS_PROVIDER=turbosms
TURBOSMS_TOKEN=REPLACE_WITH_REAL_TOKEN
SMS_SENDER=Eurotrips

# ── FILE STORAGE (S3-compatible) ────────────────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=eurotrips-documents
S3_ACCESS_KEY=REPLACE_WITH_KEY
S3_SECRET_KEY=REPLACE_WITH_SECRET
S3_REGION=eu-central-1

# ── ZOHO CRM (інтеграція до міграції) ───────────────────────────────────────
ZOHO_CLIENT_ID=REPLACE_WITH_CLIENT_ID
ZOHO_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
ZOHO_REFRESH_TOKEN=REPLACE_WITH_REFRESH_TOKEN
ZOHO_ORG_ID=REPLACE_WITH_ORG_ID

# ── SENTRY (моніторинг) ──────────────────────────────────────────────────────
SENTRY_DSN=REPLACE_WITH_DSN

# ── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ── LOGGING ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# production: info | development: debug

# ── BOOKING NUMBERS ──────────────────────────────────────────────────────────
# Формат: ET-{YEAR}-{SEQ} → ET-2025-00001
BOOKING_NUMBER_PREFIX=ET
BOOKING_NUMBER_PAD=5

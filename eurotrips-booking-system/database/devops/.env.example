# ================================================================
#  Eurotrips Booking System — змінні середовища
#  Скопіювати: cp .env.example .env
#  Заповнити всі порожні значення перед запуском!
# ================================================================

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_USER=eurotrips
POSTGRES_PASSWORD=           # ОБОВ'ЯЗКОВО: мін. 16 символів
POSTGRES_DB=eurotrips_booking

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=              # ОБОВ'ЯЗКОВО: мін. 16 символів

# ── JWT (ОБОВ'ЯЗКОВО: генерувати ключі!) ─────────────────────────
# Генерація: openssl rand -hex 32
JWT_SECRET=                  # ОБОВ'ЯЗКОВО: мін. 32 символи
JWT_REFRESH_SECRET=          # ОБОВ'ЯЗКОВО: мін. 32 символи, відмінний від JWT_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── SendGrid (prod) / MailHog (dev) ──────────────────────────────
# Dev: SMTP_HOST=mailhog, SMTP_PORT=1025 (замінюється docker-compose)
# Prod: заповнити SENDGRID_API_KEY
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@eurotrips.ua
SENDGRID_FROM_NAME=Eurotrips

# ── SMTP (dev = MailHog, налаштовується docker-compose автоматично) ──
SMTP_HOST=mailhog
SMTP_PORT=1025

# ── Telegram Bot ─────────────────────────────────────────────────
# Отримати токен у @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID для сповіщень команди (deploy, помилки)
TELEGRAM_NOTIFY_CHAT_ID=

# ── Viber ────────────────────────────────────────────────────────
VIBER_AUTH_TOKEN=
VIBER_WEBHOOK_URL=

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────────
# Prod: https://booking.eurotrips.ua,https://eurotrips.ua
CORS_ORIGIN=http://localhost:5173,http://localhost:80

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# ── BullMQ / Queue ───────────────────────────────────────────────
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3

# ── Puppeteer (PDF генерація документів) ────────────────────────
# В Docker Alpine — встановлювати Chromium окремо або використовувати
# browserless/chrome контейнер (Release 2)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=

# ── pgAdmin (тільки dev, profile: tools) ─────────────────────────
PGADMIN_PASSWORD=admin

# ── Prod: GitHub Container Registry ──────────────────────────────
# Розкоментувати для production deploy
# GITHUB_REPO=eurotrips-ua/eurotrips-booking-system
# IMAGE_TAG=latest

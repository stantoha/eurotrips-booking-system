# ============================================================
# EUROTRIPS — .env.test
# Змінні середовища для Playwright E2E тестів
#
# ⚠️  НЕ КОМІТИТИ реальні паролі / ключі в цей файл!
#     Цей файл містить ТІЛЬКИ тестові дані зі seed.
#     Для CI — передавати через GitHub Secrets.
# ============================================================

# ── URL ──────────────────────────────────────────────────────
# Frontend (Vite dev server або Docker)
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Backend API
PLAYWRIGHT_API_URL=http://localhost:3000/api/v1

# ── TEST CREDENTIALS (відповідають prisma/seed.ts) ──────────
# Змінювати тільки якщо seed.ts оновлено

TEST_ADMIN_EMAIL=admin@eurotrips.ua
TEST_ADMIN_PASSWORD=test1234

TEST_MANAGER_EMAIL=manager@eurotrips.ua
TEST_MANAGER_PASSWORD=test1234

TEST_OPS_EMAIL=ops@eurotrips.ua
TEST_OPS_PASSWORD=test1234

TEST_FINANCE_EMAIL=finance@eurotrips.ua
TEST_FINANCE_PASSWORD=test1234

TEST_AGENT_EMAIL=agent@agency.ua
TEST_AGENT_PASSWORD=test1234

TEST_AGENT2_EMAIL=agent2@agency.ua
TEST_AGENT2_PASSWORD=test1234

# ── CI flags ─────────────────────────────────────────────────
# Встановлюється автоматично в GitHub Actions: CI=true
# CI=false

index 0000000..bdc7e95
--- /dev/null
+++ b/src/modules/tour-templates/tour-templates.service.ts
@@ -0,0 +1,155 @@
+// =============================================================================
+// EUROTRIPS — Tour Templates Service
+// Шаблон туру (продукт) — джерело правди продуктової лінії.
+// Виїзди (Tour) створюються з шаблону: код [CODE][YY][MM][DD][SEQ] (§8 CLAUDE.md).
+// BR-04: модуль доступний лише внутрішнім ролям — агенти/туристи не мають доступу.
+// =============================================================================
+
+import { Prisma } from '@prisma/client';
+import prisma from '../../shared/database/prisma';
+import { AppError, Errors } from '../../shared/utils/errors';
+import type {
+  TemplateListQuery,
+  TemplateCreateInput,
+  TemplateUpdateInput,
+  DepartureCreateInput,
+} from './tour-templates.schema';
+
+export class TourTemplatesService {
+
+  async list(q: TemplateListQuery) {
+    const where: Prisma.TourTemplateWhereInput = {
+      ...(q.includeArchived ? {} : { isArchived: false }),
+      ...(q.category ? { category: q.category } : {}),
+      ...(q.search
+        ? {
+            OR: [
+              { title: { contains: q.search, mode: 'insensitive' } },
+              { siteName: { contains: q.search, mode: 'insensitive' } },
+              { code: { contains: q.search, mode: 'insensitive' } },
+            ],
+          }
+        : {}),
+    };
+    const [total, data] = await prisma.$transaction([
+      prisma.tourTemplate.count({ where }),
+      prisma.tourTemplate.findMany({
+        where,
+        orderBy: [{ title: 'asc' }],
+        skip: (q.page - 1) * q.limit,
+        take: q.limit,
+        include: { _count: { select: { tours: true } } },
+      }),
+    ]);
+    return {
+      data,
+      meta: { total, page: q.page, limit: q.limit, pages: Math.ceil(total / q.limit) },
+    };
+  }
+
+  async getById(id: string) {
+    const tpl = await prisma.tourTemplate.findUnique({
+      where: { id },
+      include: {
+        tours: {
+          orderBy: { departureDate: 'desc' },
+          select: {
+            id: true, code: true, name: true, status: true,
+            departureDate: true, returnDate: true,
+            totalSeats: true, availableSeats: true, basePrice: true,
+          },
+        },
+      },
+    });
+    if (!tpl) throw Errors.notFound('Шаблон туру', id);
+    return tpl;
+  }
+
+  async create(input: TemplateCreateInput) {
+    const dup = await prisma.tourTemplate.findUnique({
+      where: { code_title: { code: input.code, title: input.title } },
+    });
+    if (dup) {
+      throw new AppError('TEMPLATE_EXISTS', 'Шаблон з таким кодом і назвою вже існує', 409);
+    }
+    return prisma.tourTemplate.create({
+      data: {
+        ...input,
+        costs: input.costs as Prisma.InputJsonValue | undefined,
+        marketing: input.marketing as Prisma.InputJsonValue | undefined,
+        program: input.program as Prisma.InputJsonValue | undefined,
+        extra: input.extra as Prisma.InputJsonValue | undefined,
+      },
+    });
+  }
+
+  async update(id: string, input: TemplateUpdateInput) {
+    await this.getById(id);
+    return prisma.tourTemplate.update({
+      where: { id },
+      data: {
+        ...input,
+        costs: input.costs as Prisma.InputJsonValue | undefined,
+        marketing: input.marketing as Prisma.InputJsonValue | undefined,
+        program: input.program as Prisma.InputJsonValue | undefined,
+        extra: input.extra as Prisma.InputJsonValue | undefined,
+      },
+    });
+  }
+
+  /**
+   * Створення виїзду (Tour) на основі шаблону.
+   * Код: [CODE][YY][MM][DD][SEQ] — SEQ шукається серед існуючих виїздів на цю дату.
+   * Виїзд створюється в статусі draft (BR-09: відкриття — окремий крок).
+   */
+  async createDeparture(templateId: string, input: DepartureCreateInput) {
+    const tpl = await prisma.tourTemplate.findUnique({ where: { id: templateId } });
+    if (!tpl) throw Errors.notFound('Шаблон туру', templateId);
+
+    const d = input.departureDate;
+    const yy = String(d.getUTCFullYear()).slice(2);
+    const mm = String(d.getUTCMonth() + 1).padStart(2, '0');
+    const dd = String(d.getUTCDate()).padStart(2, '0');
+    const prefix = `${tpl.code}${yy}${mm}${dd}`;
+
+    const days = tpl.days ?? 1;
+    const returnDate =
+      input.returnDate ?? new Date(d.getTime() + (days - 1) * 24 * 60 * 60 * 1000);
+
+    const marketing = (tpl.marketing ?? {}) as Record<string, unknown>;
+    const included = Array.isArray(marketing.included)
+      ? (marketing.included as string[]).join('; ')
+      : null;
+    const notIncluded = Array.isArray(marketing.paidExtra)
+      ? (marketing.paidExtra as string[]).join('; ')
+      : null;
+
+    // Транзакція: SEQ обчислюється і код створюється атомарно (унікальність — @unique)
+    return prisma.$transaction(async (tx) => {
+      const siblings = await tx.tour.count({ where: { code: { startsWith: prefix } } });
+      const code = `${prefix}${String(siblings + 1).padStart(2, '0')}`;
+
+      return tx.tour.create({
+        data: {
+          code,
+          name: tpl.siteName ?? tpl.title,
+          product: tpl.title,
+          tourType: input.tourType,
+          departureDate: d,
+          returnDate,
+          durationDays: days,
+          basePrice: input.basePrice,
+          agentCommissionPct: input.agentCommissionPct,
+          totalSeats: input.totalSeats,
+          availableSeats: input.totalSeats,
+          costPrice: input.costPrice,
+          status: 'draft',
+          included,
+          notIncluded,
+          templateId: tpl.id,
+          metadata: { createdFromTemplate: tpl.id, templateCode: tpl.code },
+        },
+      });
+    });
+  }
+}

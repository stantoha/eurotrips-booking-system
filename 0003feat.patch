+// =============================================================================
+// EUROTRIPS — Tour Templates Routes
+// GET    /tour-templates            [внутрішні ролі]      — список шаблонів
+// GET    /tour-templates/:id        [внутрішні ролі]      — шаблон + виїзди
+// POST   /tour-templates            [admin, product_manager] — «Новий тур»
+// PATCH  /tour-templates/:id        [admin, product_manager]
+// POST   /tour-templates/:id/departures [admin, product_manager, ops] — «Створити виїзд»
+// BR-04: агенти й туристи доступу не мають (собівартісні компоненти в costs).
+// =============================================================================
+
+import { FastifyInstance, FastifyRequest, FastifyReply } from 'fastify';
+import { TourTemplatesService } from './tour-templates.service';
+import {
+  TemplateListQuerySchema,
+  TemplateCreateSchema,
+  TemplateUpdateSchema,
+  DepartureCreateSchema,
+} from './tour-templates.schema';
+import { requireAuth } from '../../shared/guards/jwt.guard';
+import { requireRoles } from '../../shared/guards/rbac.guard';
+
+const ID_PARAM = {
+  type: 'object',
+  properties: { id: { type: 'string', format: 'uuid' } },
+  required: ['id'],
+} as const;
+
+const READ_ROLES = ['admin', 'director', 'manager', 'ops', 'accountant', 'product_manager', 'logist'] as const;
+const WRITE_ROLES = ['admin', 'product_manager'] as const;
+
+export async function tourTemplateRoutes(app: FastifyInstance) {
+  const service = new TourTemplatesService();
+
+  app.get('/', {
+    preHandler: [requireAuth, requireRoles(...READ_ROLES)],
+    schema: { summary: 'Список шаблонів турів (продуктів)', tags: ['Tours'], security: [{ bearerAuth: [] }] },
+  }, async (req: FastifyRequest, reply: FastifyReply) => {
+    return reply.send(await service.list(TemplateListQuerySchema.parse(req.query)));
+  });
+
+  app.get<{ Params: { id: string } }>('/:id', {
+    preHandler: [requireAuth, requireRoles(...READ_ROLES)],
+    schema: { summary: 'Шаблон туру + виїзди', tags: ['Tours'], security: [{ bearerAuth: [] }], params: ID_PARAM },
+  }, async (req, reply) => {
+    return reply.send({ data: await service.getById(req.params.id) });
+  });
+
+  app.post('/', {
+    preHandler: [requireAuth, requireRoles(...WRITE_ROLES)],
+    schema: { summary: 'Створити шаблон туру («Новий тур»)', tags: ['Tours'], security: [{ bearerAuth: [] }] },
+  }, async (req: FastifyRequest, reply: FastifyReply) => {
+    const tpl = await service.create(TemplateCreateSchema.parse(req.body));
+    return reply.code(201).send({ data: tpl });
+  });
+
+  app.patch<{ Params: { id: string } }>('/:id', {
+    preHandler: [requireAuth, requireRoles(...WRITE_ROLES)],
+    schema: { summary: 'Оновити шаблон туру', tags: ['Tours'], security: [{ bearerAuth: [] }], params: ID_PARAM },
+  }, async (req, reply) => {
+    return reply.send({ data: await service.update(req.params.id, TemplateUpdateSchema.parse(req.body)) });
+  });
+
+  app.post<{ Params: { id: string } }>('/:id/departures', {
+    preHandler: [requireAuth, requireRoles('admin', 'product_manager', 'ops')],
+    schema: { summary: 'Створити виїзд (Tour) на основі шаблону', tags: ['Tours'], security: [{ bearerAuth: [] }], params: ID_PARAM },
+  }, async (req, reply) => {
+    const tour = await service.createDeparture(req.params.id, DepartureCreateSchema.parse(req.body));
+    return reply.code(201).send({ data: tour });
+  });
+}

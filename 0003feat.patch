+// =============================================================================
+// EUROTRIPS — Сід шаблонів турів (продуктів) з CSV
+// Джерела (prisma/data/tour-templates/):
+//   prod_legend.csv   — база продукту: код, собівартісні компоненти, приєднання
+//   tours_main.csv    — сайт: маршрут, included/paid/допи/фішки (ключ: URL)
+//   tours_program.csv — сайт: програма по днях (ключ: URL)
+//   tours_dates.csv   — сайт: дати продажу, ціни, залишок місць (ключ: URL)
+//   calendar_new.csv  — календар виїздів план/факт (ключ: код продукту в ID)
+// Запуск: npm run db:seed:templates
+// Ідемпотентний: upsert по @@unique([code, title])
+// =============================================================================
+
+import { PrismaClient, Prisma } from '@prisma/client';
+import * as fs from 'fs';
+import * as path from 'path';
+
+const prisma = new PrismaClient();
+const DATA_DIR = path.join(__dirname, 'data', 'tour-templates');
+
+// ── CSV-парсер (лапки, коми та переноси рядків усередині полів) ─────────────
+function parseCsv(text: string): string[][] {
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = '';
+  let inQuotes = false;
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    if (inQuotes) {
+      if (ch === '"') {
+        if (text[i + 1] === '"') { field += '"'; i++; }
+        else inQuotes = false;
+      } else field += ch;
+    } else if (ch === '"') inQuotes = true;
+    else if (ch === ',') { row.push(field); field = ''; }
+    else if (ch === '\n') { row.push(field); rows.push(row); row = []; field = ''; }
+    else if (ch !== '\r') field += ch;
+  }
+  if (field !== '' || row.length) { row.push(field); rows.push(row); }
+  return rows;
+}
+
+function readCsv(file: string): string[][] {
+  return parseCsv(fs.readFileSync(path.join(DATA_DIR, file), 'utf-8'));
+}
+
+// "3 770" → 3770; "1,4" → 1.4; "€109,00" → 109; порожнє → null
+function num(v: string | undefined): number | null {
+  if (!v) return null;
+  const clean = v.replace(/[€\s ]/g, '').replace(',', '.');
+  if (!clean) return null;
+  const n = Number(clean);
+  return Number.isFinite(n) ? n : null;
+}
+
+const norm = (s: string) => s.toLowerCase().replace(/[^а-яіїєґa-z0-9]/gi, '');
+
+// "переїзд;; проживання;;" → масив пунктів
+function list(v: string | undefined): string[] {
+  if (!v) return [];
+  return v.split(/;;|;/).map((s) => s.trim()).filter(Boolean);
+}
+
+async function main() {
+  // ── 1. PROD_LEGEND — база продуктів ────────────────────────────────────
+  const legend = readCsv('prod_legend.csv').slice(2); // 2 службові рядки заголовків
+  type Tpl = {
+    code: string; year: number | null; title: string;
+    siteName: string | null; siteUrl: string | null; category: string | null;
+    days: number | null; joinPoints: string | null;
+    costs: Record<string, number | null>;
+  };
+  const templates: Tpl[] = [];
+  for (const r of legend) {
+    const code = (r[1] ?? '').trim();
+    const title = (r[2] ?? '').trim();
+    if (!code || !title) continue;
+    templates.push({
+      code,
+      year: num(r[0]),
+      title,
+      siteUrl: (r[20] ?? '').trim() || null,
+      siteName: (r[21] ?? '').trim() || null,
+      category: (r[22] ?? '').trim() || null,
+      days: num(r[3]),
+      joinPoints: (r[19] ?? '').trim() || null,
+      costs: {
+        staff: num(r[4]),                 // Персонал
+        staffTravel: num(r[5]),           // Проїзд стаф
+        tourLeaderSalary: num(r[6]),      // Зарплата КГ
+        mobile: num(r[7]),                // Моб. зв'язок
+        staffAccommodation: num(r[8]),    // Проживання персоналу
+        transport: num(r[9]),             // Транспорт
+        kmGoogle: num(r[10]),             // км Google
+        tariffPerKm: num(r[11]),          // Тариф за 1 км
+        guides: num(r[12]),               // Гіди
+        additional: num(r[13]),           // Додатково
+        extraExpenses: num(r[14]),        // Додаткові витрати
+        parkingsCheckpoints: num(r[15]),  // Парковки + чек-поінти
+        tourGuidesPerGroup: num(r[16]),   // Тургіди на групу
+        insurancePerGroup: num(r[17]),    // Страхування на групу
+        extrasPlanFromDb: num(r[18]),     // ДОПи план з Бази турів
+        staffCostCalc: num(r[23]),        // Розрахунок для персоналу в СВ
+      },
+    });
+  }
+
+  // ── 2. Tours_Main — маркетинг з сайту (по URL) ─────────────────────────
+  const mainRows = readCsv('tours_main.csv').slice(1);
+  const marketingByUrl = new Map<string, Record<string, unknown>>();
+  const routeByUrl = new Map<string, string>();
+  for (const r of mainRows) {
+    const url = (r[0] ?? '').trim().split('?')[0];
+    if (!url) continue;
+    routeByUrl.set(url, (r[2] ?? '').trim());
+    marketingByUrl.set(url, {
+      siteTitle: (r[1] ?? '').trim(),
+      days: num(r[3]),
+      hotelNights: num(r[4]),
+      nightTransfers: num(r[5]),
+      breakfasts: num(r[6]),
+      minPrice: num(r[7]),
+      upcomingDatesText: (r[8] ?? '').trim(),
+      included: list(r[9]),
+      paidExtra: list(r[10]),
+      optionalExtras: list(r[11]),
+      highlights: (r[12] ?? '').split(';').map((s) => s.trim()).filter(Boolean),
+      importantInfo: (r[13] ?? '').trim() || null,
+      parsedAt: (r[14] ?? '').trim() || null,
+    });
+  }
+
+  // ── 3. Tours_Program — програма по днях (по URL) ───────────────────────
+  const progRows = readCsv('tours_program.csv').slice(1);
+  const programByUrl = new Map<string, unknown[]>();
+  for (const r of progRows) {
+    const url = (r[0] ?? '').trim().split('?')[0];
+    if (!url) continue;
+    const arr = programByUrl.get(url) ?? [];
+    arr.push({
+      day: num(r[2]),
+      city: (r[3] ?? '').trim(),
+      tags: (r[4] ?? '').split(';').map((s) => s.trim()).filter(Boolean),
+      description: (r[5] ?? '').trim(),
+    });
+    programByUrl.set(url, arr);
+  }
+
+  // ── 4. Tours_Dates — дати продажу (по URL) ─────────────────────────────
+  const dateRows = readCsv('tours_dates.csv').slice(1);
+  const datesByUrl = new Map<string, unknown[]>();
+  for (const r of dateRows) {
+    const url = (r[0] ?? '').trim().split('?')[0];
+    if (!url) continue;
+    const arr = datesByUrl.get(url) ?? [];
+    arr.push({
+      dates: (r[2] ?? '').trim(),
+      note: (r[3] ?? '').trim() || null,
+      price: num(r[4]),
+      oldPrice: num(r[5]),
+      seatsLeft: num(r[6]),
+    });
+    datesByUrl.set(url, arr);
+  }
+
+  // ── 5. Calendar NEW — виїзди план/факт (по коду продукту в ID) ─────────
+  const calRows = readCsv('calendar_new.csv').slice(1);
+  type Dep = Record<string, unknown> & { _code: string; _product: string };
+  const departures: Dep[] = [];
+  for (const r of calRows) {
+    const depId = (r[2] ?? '').trim(); // LP26010301
+    if (!/^[A-ZА-Я]{2}\d{8}$/i.test(depId)) continue;
+    departures.push({
+      _code: depId.slice(0, 2).toUpperCase(),
+      _product: (r[6] ?? '').trim(),
+      id: depId,
+      period: (r[1] ?? '').trim(),
+      fullName: (r[3] ?? '').trim(),
+      status: (r[4] ?? '').trim(),
+      start: (r[5] ?? '').trim(),
+      days: num(r[7]),
+      touristsPlanCrm: num(r[8]),
+      touristsManual: num(r[9]),
+      costPerPerson: num(r[10]),
+      accommodation: num(r[11]),
+      programCostPerPerson: num(r[12]),
+      transport: num(r[13]),
+      staff: num(r[14]),
+      guides: num(r[15]),
+      additional: num(r[16]),
+      indirectCosts: num(r[17]),
+      planProfitAdds: num(r[18]),
+      asanaLink: (r[19] ?? '').trim() || null,
+      kmGoogle: num(r[24]),
+      transportTariff: num(r[25]),
+    });
+  }
+
+  // Прив'язка виїзду до шаблону: спершу точний збіг назви продукту, далі — код
+  function depsForTemplate(t: Tpl): Dep[] {
+    const byName = departures.filter((d) => norm(d._product) === norm(t.title));
+    if (byName.length) return byName;
+    const sameCodeTemplates = templates.filter((x) => x.code === t.code);
+    if (sameCodeTemplates.length === 1) {
+      return departures.filter((d) => d._code === t.code.toUpperCase());
+    }
+    return []; // код неоднозначний і назва не збіглась — не приписуємо
+  }
+
+  // ── Upsert ──────────────────────────────────────────────────────────────
+  let created = 0, updated = 0;
+  for (const t of templates) {
+    const url = t.siteUrl?.split('?')[0] ?? '';
+    const deps = depsForTemplate(t).map(({ _code, _product, ...d }) => d);
+    const data = {
+      year: t.year,
+      siteName: t.siteName,
+      siteUrl: t.siteUrl,
+      category: t.category,
+      days: t.days,
+      routeCities: routeByUrl.get(url) ?? null,
+      joinPoints: t.joinPoints,
+      costs: t.costs as Prisma.InputJsonValue,
+      marketing: (marketingByUrl.get(url) ?? undefined) as Prisma.InputJsonValue | undefined,
+      program: (programByUrl.get(url) ?? undefined) as Prisma.InputJsonValue | undefined,
+      saleDates: (datesByUrl.get(url) ?? undefined) as Prisma.InputJsonValue | undefined,
+      departuresLog: (deps.length ? deps : undefined) as Prisma.InputJsonValue | undefined,
+    };
+    const existing = await prisma.tourTemplate.findUnique({
+      where: { code_title: { code: t.code, title: t.title } },
+    });
+    if (existing) {
+      await prisma.tourTemplate.update({ where: { id: existing.id }, data });
+      updated++;
+    } else {
+      await prisma.tourTemplate.create({ data: { code: t.code, title: t.title, ...data } });
+      created++;
+    }
+  }
+
+  console.log(`✅ Шаблони турів: створено ${created}, оновлено ${updated} (всього в CSV: ${templates.length})`);
+  console.log(`   Виїздів у календарі: ${departures.length}`);
+}
+
+main()
+  .catch((e) => { console.error('❌ Помилка сіду шаблонів:', e); process.exit(1); })
+  .finally(() => prisma.$disconnect());

@@ -0,0 +1,193 @@
+// ============================================================
+// EUROTRIPS — Модалка «Новий тур»
+// Крок 1: створення шаблону туру (продукту) → POST /tour-templates
+// Крок 2 (опційно): створення першого виїзду → POST /tour-templates/:id/departures
+// Доступ: admin, product_manager (кнопка в Tours.tsx)
+// ============================================================
+
+import { useState } from 'react';
+import { useNavigate } from 'react-router-dom';
+import { useQueryClient } from '@tanstack/react-query';
+import { X, Loader2 } from 'lucide-react';
+import { api } from '../../services/api';
+
+interface Props {
+  onClose: () => void;
+}
+
+const CATEGORIES = ['екскурсійний', 'морський', 'гірський'];
+
+const inputCls =
+  'w-full px-3 py-2 text-sm rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500';
+const labelCls = 'block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1';
+
+export default function NewTourModal({ onClose }: Props) {
+  const navigate = useNavigate();
+  const queryClient = useQueryClient();
+
+  const [step, setStep] = useState<1 | 2>(1);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [templateId, setTemplateId] = useState<string | null>(null);
+
+  // Крок 1 — шаблон
+  const [code, setCode] = useState('');
+  const [title, setTitle] = useState('');
+  const [siteName, setSiteName] = useState('');
+  const [siteUrl, setSiteUrl] = useState('');
+  const [category, setCategory] = useState('екскурсійний');
+  const [days, setDays] = useState('');
+  const [routeCities, setRouteCities] = useState('');
+  const [joinPoints, setJoinPoints] = useState('');
+
+  // Крок 2 — виїзд
+  const [departureDate, setDepartureDate] = useState('');
+  const [basePrice, setBasePrice] = useState('');
+  const [totalSeats, setTotalSeats] = useState('50');
+  const [commissionPct, setCommissionPct] = useState('14');
+
+  const apiError = (e: unknown): string => {
+    const err = e as { response?: { data?: { error?: { message?: string } } } };
+    return err.response?.data?.error?.message ?? 'Сталася помилка. Спробуйте ще раз.';
+  };
+
+  const createTemplate = async () => {
+    setBusy(true); setError(null);
+    try {
+      const { data } = await api.post('/tour-templates', {
+        code: code.trim().toUpperCase(),
+        title: title.trim(),
+        siteName: siteName.trim() || undefined,
+        siteUrl: siteUrl.trim() || undefined,
+        category,
+        days: days ? Number(days) : undefined,
+        routeCities: routeCities.trim() || undefined,
+        joinPoints: joinPoints.trim() || undefined,
+      });
+      setTemplateId(data.data.id);
+      setStep(2);
+    } catch (e) { setError(apiError(e)); }
+    finally { setBusy(false); }
+  };
+
+  const createDeparture = async () => {
+    if (!templateId) return;
+    setBusy(true); setError(null);
+    try {
+      const { data } = await api.post(`/tour-templates/${templateId}/departures`, {
+        departureDate,
+        basePrice: Number(basePrice),
+        totalSeats: Number(totalSeats),
+        agentCommissionPct: Number(commissionPct) / 100,
+      });
+      queryClient.invalidateQueries({ queryKey: ['tours'] });
+      onClose();
+      navigate(`/tours/${data.data.id}`);
+    } catch (e) { setError(apiError(e)); }
+    finally { setBusy(false); }
+  };
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4" onClick={onClose}>
+      <div
+        className="w-full max-w-lg rounded-2xl bg-white dark:bg-slate-900 shadow-xl p-6 max-h-[90vh] overflow-y-auto"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="flex items-center justify-between mb-4">
+          <h2 className="text-lg font-semibold text-slate-900 dark:text-slate-100">
+            {step === 1 ? 'Новий тур (шаблон продукту)' : 'Перший виїзд туру'}
+          </h2>
+          <button onClick={onClose} className="text-slate-400 hover:text-slate-600" aria-label="Закрити">
+            <X size={18} />
+          </button>
+        </div>
+
+        {step === 1 ? (
+          <div className="space-y-3">
+            <div className="grid grid-cols-3 gap-3">
+              <div>
+                <label className={labelCls}>Код продукту *</label>
+                <input value={code} onChange={(e) => setCode(e.target.value)} placeholder="LP" maxLength={10} className={inputCls} />
+              </div>
+              <div className="col-span-2">
+                <label className={labelCls}>Назва продукту *</label>
+                <input value={title} onChange={(e) => setTitle(e.target.value)} placeholder="Лапландія" className={inputCls} />
+              </div>
+            </div>
+            <div>
+              <label className={labelCls}>Назва на сайті</label>
+              <input value={siteName} onChange={(e) => setSiteName(e.target.value)} className={inputCls} />
+            </div>
+            <div>
+              <label className={labelCls}>URL програми на сайті</label>
+              <input value={siteUrl} onChange={(e) => setSiteUrl(e.target.value)} placeholder="https://eurotrips.ua/…" className={inputCls} />
+            </div>
+            <div className="grid grid-cols-2 gap-3">
+              <div>
+                <label className={labelCls}>Категорія</label>
+                <select value={category} onChange={(e) => setCategory(e.target.value)} className={inputCls}>
+                  {CATEGORIES.map((c) => <option key={c} value={c}>{c}</option>)}
+                </select>
+              </div>
+              <div>
+                <label className={labelCls}>Тривалість, днів</label>
+                <input type="number" min={1} value={days} onChange={(e) => setDays(e.target.value)} className={inputCls} />
+              </div>
+            </div>
+            <div>
+              <label className={labelCls}>Маршрут (міста)</label>
+              <input value={routeCities} onChange={(e) => setRouteCities(e.target.value)} placeholder="Львів → Будапешт → Відень" className={inputCls} />
+            </div>
+            <div>
+              <label className={labelCls}>Місця та час приєднання</label>
+              <textarea value={joinPoints} onChange={(e) => setJoinPoints(e.target.value)} rows={2} className={inputCls} />
+            </div>
+          </div>
+        ) : (
+          <div className="space-y-3">
+            <p className="text-sm text-slate-500 dark:text-slate-400">
+              Шаблон збережено. Створіть перший виїзд або закрийте вікно — виїзди можна додати пізніше.
+            </p>
+            <div className="grid grid-cols-2 gap-3">
+              <div>
+                <label className={labelCls}>Дата виїзду *</label>
+                <input type="date" value={departureDate} onChange={(e) => setDepartureDate(e.target.value)} className={inputCls} />
+              </div>
+              <div>
+                <label className={labelCls}>Базова ціна, € *</label>
+                <input type="number" min={1} value={basePrice} onChange={(e) => setBasePrice(e.target.value)} className={inputCls} />
+              </div>
+              <div>
+                <label className={labelCls}>Кількість місць *</label>
+                <input type="number" min={1} max={100} value={totalSeats} onChange={(e) => setTotalSeats(e.target.value)} className={inputCls} />
+              </div>
+              <div>
+                <label className={labelCls}>Комісія агента, %</label>
+                <input type="number" min={0} max={50} value={commissionPct} onChange={(e) => setCommissionPct(e.target.value)} className={inputCls} />
+              </div>
+            </div>
+          </div>
+        )}
+
+        {error && <p className="mt-3 text-sm text-red-500">{error}</p>}
+
+        <div className="flex justify-end gap-2 mt-5">
+          <button
+            onClick={onClose}
+            className="px-4 py-2 text-sm rounded-pill border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800"
+          >
+            {step === 1 ? 'Скасувати' : 'Закрити без виїзду'}
+          </button>
+          <button
+            onClick={step === 1 ? createTemplate : createDeparture}
+            disabled={busy || (step === 1 ? !code.trim() || !title.trim() : !departureDate || !basePrice)}
+            className="flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-pill bg-brand-red text-white hover:bg-brand-red-dark disabled:opacity-50 transition-colors"
+          >
+            {busy && <Loader2 size={14} className="animate-spin" />}
+            {step === 1 ? 'Створити шаблон' : 'Створити виїзд'}
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}

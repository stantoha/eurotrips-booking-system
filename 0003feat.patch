+-- Шаблони турів (продукти) — джерело правди для продуктової лінії
+CREATE TABLE "tour_templates" (
+    "id" UUID NOT NULL DEFAULT uuid_generate_v4(),
+    "code" VARCHAR(10) NOT NULL,
+    "year" INTEGER,
+    "title" VARCHAR(255) NOT NULL,
+    "site_name" VARCHAR(255),
+    "site_url" TEXT,
+    "category" VARCHAR(50),
+    "days" INTEGER,
+    "route_cities" TEXT,
+    "join_points" TEXT,
+    "costs" JSONB,
+    "marketing" JSONB,
+    "program" JSONB,
+    "sale_dates" JSONB,
+    "departures_log" JSONB,
+    "extra" JSONB,
+    "is_archived" BOOLEAN NOT NULL DEFAULT false,
+    "created_at" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updated_at" TIMESTAMP(3) NOT NULL,
+
+    CONSTRAINT "tour_templates_pkey" PRIMARY KEY ("id")
+);
+
+CREATE UNIQUE INDEX "tour_templates_code_title_key" ON "tour_templates"("code", "title");
+CREATE INDEX "tour_templates_code_idx" ON "tour_templates"("code");
+CREATE INDEX "tour_templates_is_archived_idx" ON "tour_templates"("is_archived");
+
+-- Виїзд (Tour) посилається на шаблон
+ALTER TABLE "tours" ADD COLUMN "template_id" UUID;
+
+ALTER TABLE "tours" ADD CONSTRAINT "tours_template_id_fkey"
+    FOREIGN KEY ("template_id") REFERENCES "tour_templates"("id") ON DELETE SET NULL ON UPDATE CASCADE;
+
+CREATE INDEX "tours_template_id_idx" ON "tours"("template_id");

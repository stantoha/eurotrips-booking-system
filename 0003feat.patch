@@ -0,0 +1,47 @@
+// =============================================================================
+// EUROTRIPS — Tour Templates: Zod-схеми
+// =============================================================================
+
+import { z } from 'zod';
+
+export const TemplateListQuerySchema = z.object({
+  search: z.string().optional(),
+  category: z.string().optional(),
+  includeArchived: z.coerce.boolean().default(false),
+  page: z.coerce.number().int().min(1).default(1),
+  limit: z.coerce.number().int().min(1).max(100).default(20),
+});
+
+export const TemplateCreateSchema = z.object({
+  code: z.string().trim().min(2).max(10).toUpperCase(),
+  title: z.string().trim().min(2).max(255),
+  year: z.number().int().min(2020).max(2100).optional(),
+  siteName: z.string().trim().max(255).optional(),
+  siteUrl: z.string().trim().url().optional(),
+  category: z.string().trim().max(50).optional(),
+  days: z.number().int().min(1).max(60).optional(),
+  routeCities: z.string().trim().optional(),
+  joinPoints: z.string().trim().optional(),
+  costs: z.record(z.unknown()).optional(),
+  marketing: z.record(z.unknown()).optional(),
+  program: z.array(z.record(z.unknown())).optional(),
+  extra: z.record(z.unknown()).optional(),
+});
+
+export const TemplateUpdateSchema = TemplateCreateSchema.partial();
+
+// Створення виїзду (Tour) на основі шаблону
+export const DepartureCreateSchema = z.object({
+  departureDate: z.coerce.date(),
+  returnDate: z.coerce.date().optional(),
+  basePrice: z.number().positive(),
+  totalSeats: z.number().int().min(1).max(100),
+  agentCommissionPct: z.number().min(0).max(0.5).default(0.14),
+  tourType: z.enum(['bus', 'avia', 'combined']).default('bus'),
+  costPrice: z.number().positive().optional(),
+});
+
+export type TemplateListQuery = z.infer<typeof TemplateListQuerySchema>;
+export type TemplateCreateInput = z.infer<typeof TemplateCreateSchema>;
+export type TemplateUpdateInput = z.infer<typeof TemplateUpdateSchema>;
+export type DepartureCreateInput = z.infer<typeof DepartureCreateSchema>;

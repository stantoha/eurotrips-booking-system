// =============================================================================
// MODEL 18: documents
// Всі документи: ваучери, договори, рахунки, списки туристів.
// =============================================================================
model Document {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId    String?      @map("booking_id") @db.Uuid
  tourId       String?      @map("tour_id") @db.Uuid
  agentId      String?      @map("agent_id") @db.Uuid
  docType      DocumentType @map("doc_type")
  docFor       DocumentFor  @map("doc_for")
  title        String       @db.VarChar(255)
  /// Шлях до файлу в S3 / storage
  filePath     String?      @map("file_path") @db.Text
  fileSizeKb   Int?         @map("file_size_kb")
  mimeType     String?      @map("mime_type") @db.VarChar(50)
  generatedAt  DateTime     @default(now()) @map("generated_at")
  generatedById String      @map("generated_by_id") @db.Uuid
  isSent       Boolean      @default(false) @map("is_sent")
  sentAt       DateTime?    @map("sent_at")

  // Relations
  booking     Booking?  @relation(fields: [bookingId], references: [id])
  tour        Tour?     @relation(fields: [tourId], references: [id])
  agent       Agent?    @relation(fields: [agentId], references: [id])
  generatedBy User      @relation(fields: [generatedById], references: [id])

  @@index([bookingId])
  @@index([docType])
  @@index([docFor])
  @@map("documents")
}

// =============================================================================
// MODEL 19: communications
// Лог всіх комунікацій: email, SMS, Telegram, Viber, внутрішні.
// =============================================================================
model Communication {
  id          String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId   String?                @map("booking_id") @db.Uuid
  touristId   String?                @map("tourist_id") @db.Uuid
  agentId     String?                @map("agent_id") @db.Uuid
  channel     CommunicationChannel
  direction   CommunicationDirection @default(outbound)
  subject     String?                @db.VarChar(255)
  body        String?                @db.Text
  templateId  String?                @map("template_id") @db.VarChar(100)
  status      CommunicationStatus    @default(pending)
  sentAt      DateTime?              @map("sent_at")
  errorMessage String?               @map("error_message") @db.Text
  createdAt   DateTime               @default(now()) @map("created_at")

  // Relations
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@map("communications")
}

// =============================================================================
// MODEL 20: audit_log
// Журнал змін для безпеки та відстеження. Зберігає хто, що і коли змінив.
// =============================================================================
model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  /// Назва таблиці: "bookings", "tours", "payments", ...
  tableName  String   @map("table_name") @db.VarChar(100)
  recordId   String   @map("record_id") @db.VarChar(100)
  /// JSON зі старими значеннями
  oldData    Json?    @map("old_data")
  /// JSON з новими значеннями
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tableName, recordId])
  @@index([createdAt])
  @@map("audit_log")
}

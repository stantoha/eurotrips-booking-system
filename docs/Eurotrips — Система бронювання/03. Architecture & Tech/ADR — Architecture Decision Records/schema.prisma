  city          String    @db.VarChar(100)
  /// Основна | Додаткова | ДОП
  programType   String?   @map("program_type") @db.VarChar(50)
  activityDate  DateTime  @map("activity_date") @db.Date
  activityName  String    @map("activity_name") @db.VarChar(255)
  startTime     DateTime? @map("start_time") @db.Time

// =============================================================================
// EUROTRIPS — Система бронювання
// Prisma Schema v1.1 — OPS Migration
// Мова проекту: Українська
// Джерело: ADR-001 + Frontend CLAUDE.md + statuses.ts + OPS-01/02/03
// Зміни v1.1: +2 enum (RoomingStatus, RoomType оновлено),
//             +6 полів booking_tourists, +14 полів hotel_bookings, +3 індекси
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp")]
}

// =============================================================================
// ENUMS
// Синхронізовані з frontend: src/constants/statuses.ts
// =============================================================================

enum UserRole {
  admin
  director
  manager
  ops
  agent
  accountant
  tourist

  @@map("user_role")
}

/// Два типи агентів. standard = звичайний, network = мережевий (має royalty + co_commission)
enum AgentType {
  standard
  network

  @@map("agent_type")
}

enum AgentStatus {
  active
  suspended
  blocked

  @@map("agent_status")
}

enum TourType {
  bus
  avia
  combined

  @@map("tour_type")
}

/// Синхронізовано з frontend TourStatus (8 значень)
enum TourStatus {
  draft
  open
  active
  almost_full
  closed
  on_tour
  completed
  cancelled

  @@map("tour_status")
}

enum BookingType {
  direct
  agent
  corporate
  group

  @@map("booking_type")
}

/// Синхронізовано з frontend BookingStatus (15 значень) — statuses.ts
enum BookingStatus {
  new
  in_work
  needs_clarification
  pre_booked
  awaiting_payment
  partially_paid
  confirmed
  docs_collected
  ready_to_depart
  on_trip
  completed
  cancelled_client
  cancelled_operator
  no_show
  refund

  @@map("booking_status")
}

/// Синхронізовано з frontend PaymentStatus (5 значень)
enum BookingPaymentStatus {
  unpaid
  deposit_paid
  partially_paid
  fully_paid
  overdue

  @@map("booking_payment_status")
}

enum PaymentType {
  deposit
  balance
  refund
  commission
  penalty

  @@map("payment_type")
}

enum PaymentMethod {
  card
  bank_transfer
  cash
  payment_link

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  confirmed
  failed
  refunded

  @@map("payment_status")
}

enum LeadSource {
  site
  instagram
  facebook
  telegram
  viber
  phone
  email
  agent
  repeat
  corporate

  @@map("lead_source")
}

/// Синхронізовано з frontend LeadStatus (7 значень)
enum LeadStatus {
  new
  in_work
  needs_clarification
  proposal_sent
  waiting_decision
  won
  lost

  @@map("lead_status")
}

/// Синхронізовано з frontend CommissionStatus (5 значень)
enum CommissionStatus {
  pending
  frozen
  to_pay
  paid
  cancelled

  @@map("commission_status")
}

enum StaffRole {
  tour_leader
  guide
  driver
  coordinator

  @@map("staff_role")
}

enum DocumentType {
  voucher
  contract
  invoice
  tourist_list
  boarding_list
  letter
  pdf_report

  @@map("document_type")
}

enum DocumentFor {
  tourist
  agent
  accounting
  internal
  supplier

  @@map("document_for")
}

enum CommunicationChannel {
  email
  sms
  telegram
  viber
  internal

  @@map("communication_channel")
}

enum CommunicationDirection {
  outbound
  inbound

  @@map("communication_direction")
}

enum CommunicationStatus {
  pending
  sent
  delivered
  failed
  read

  @@map("communication_status")
}

/// Тип номеру. Використовується в booking_tourists (preferred + actual)
/// Оновлено: OPS-01/OPS-03 — додано no_preference, перейменовано dbl/sngl/trpl
enum RoomType {
  twin          // Двомісний, роздільні ліжка
  double        // Двомісний, двоспальне ліжко
  triple        // Тримісний
  single        // Одномісний
  no_preference // Турист не має переваги (OPS-03)

  @@map("room_type")
}

/// Машина стану румінгу (OPS-01/OPS-02/OPS-03)
/// DRAFT → APPROVED → FINAL
enum RoomingStatus {
  draft    // Структуру внесено, не затверджено продактом
  approved // Продакт затвердив — редагування заблоковано для ops
  final    // Передано логісту, румінг закрито, self-service туриста вимкнено

  @@map("rooming_status")
}

// =============================================================================
// MODEL 1: users
// Всі користувачі системи: менеджери, агенти, туристи, бухгалтери, тощо
// =============================================================================
model User {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  agentProfile       Agent?
  staffProfile       Staff?
  managedLeads       Lead[]     @relation("LeadManager")
  managedBookings    Booking[]  @relation("BookingManager")
  confirmedPayments  Payment[]  @relation("PaymentConfirmer")
  generatedDocuments Document[]
  auditLogs          AuditLog[]
  approvedHotelBookings HotelBooking[] @relation("HotelBookingApprover")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// =============================================================================
// MODEL 2: tourists
// Клієнти / туристи. Можуть існувати без User-акаунта.
// =============================================================================
model Tourist {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  middleName     String?   @map("middle_name") @db.VarChar(100)
  email          String?   @unique @db.VarChar(255)
  phone          String?   @db.VarChar(30)
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  passportNumber String?   @map("passport_number") @db.VarChar(50)
  passportExpiry DateTime? @map("passport_expiry") @db.Date
  nationality    String?   @db.VarChar(100)
  sourceChannel  String?   @map("source_channel") @db.VarChar(100)
  isRepeat       Boolean   @default(false) @map("is_repeat")
  notes          String?   @db.Text

  // ── Zoho CRM Integration ─────────────────────────────────────
  externalId          String?   @unique @map("external_id") @db.VarChar(100)
  linkedinUrl         String?   @map("linkedin_url") @db.VarChar(255)
  agentId             String?   @map("agent_id") @db.Uuid
  allergies           String?   @db.Text
  dietaryRestrictions String?   @map("dietary_restrictions") @db.Text
  isSubscribed        Boolean   @default(false) @map("is_subscribed")
  metadata            Json?

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  contactForBookings    Booking[]       @relation("BookingContact")
  bookingParticipations BookingTourist[]
  leads                 Lead[]
  payments              Payment[]
  agent                 Agent?          @relation("TouristAgent", fields: [agentId], references: [id])

  @@index([email])
  @@index([phone])
  @@index([lastName, firstName])
  @@index([externalId])
  @@map("tourists")
}

// =============================================================================
// MODEL 3: agent_networks
// Довідник мереж турагентств (для агентів типу network)
// =============================================================================
model AgentNetwork {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String    @db.VarChar(255)
  /// % комісії ЦО мережі (напр. 0.0200 = 2%)
  coCommissionPct  Decimal   @map("co_commission_pct") @db.Decimal(5, 4)
  /// % роялті франшизи (напр. 0.0100 = 1%)
  royaltyPct       Decimal   @map("royalty_pct") @db.Decimal(5, 4)
  contractNumber   String?   @map("contract_number") @db.VarChar(100)
  contractDate     DateTime? @map("contract_date") @db.Date
  contactPerson    String?   @map("contact_person") @db.VarChar(255)
  email            String?   @db.VarChar(255)
  phone            String?   @db.VarChar(30)
  /// active | suspended | terminated
  status           String    @default("active") @db.VarChar(30)
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  agents Agent[]

  @@map("agent_networks")
}

// =============================================================================
// MODEL 4: agents
// КРИТИЧНО: agent_type розрізняє standard (без мережі) та network (з роялті + ЦО)
// Формула виплати network: agent_payout = price × (commission_pct − co_commission_pct − royalty_pct)
// =============================================================================
model Agent {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String      @unique @map("user_id") @db.Uuid
  agencyName      String?     @map("agency_name") @db.VarChar(255)
  /// standard або network — КРИТИЧНЕ поле
  agentType       AgentType   @default(standard) @map("agent_type")
  /// NULL для standard, обов'язкове для network
  networkId       String?     @map("network_id") @db.Uuid
  /// Базова комісія агента (напр. 0.1400 = 14%)
  commissionPct   Decimal     @map("commission_pct") @db.Decimal(5, 4)
  /// NULL для standard; % що іде до ЦО мережі для network
  coCommissionPct Decimal?    @map("co_commission_pct") @db.Decimal(5, 4)
  /// NULL для standard; % роялті франшизи для network
  royaltyPct      Decimal?    @map("royalty_pct") @db.Decimal(5, 4)
  contractNumber  String?     @map("contract_number") @db.VarChar(100)
  contractDate    DateTime?   @map("contract_date") @db.Date
  status          AgentStatus @default(active)
  /// Поточний баланс нарахованих комісій (EUR)
  balance         Decimal     @default(0) @db.Decimal(10, 2)
  city            String?     @db.VarChar(100)
  country         String?     @db.VarChar(100)
  notes           String?     @db.Text

  // ── Zoho CRM Integration ─────────────────────────────────────
  externalId    String?     @unique @map("external_id") @db.VarChar(100)
  contactName   String?     @map("contact_name") @db.VarChar(255)
  website       String?     @db.VarChar(255)
  agencySize    String?     @map("agency_size") @db.VarChar(50)
  taxCode       String?     @map("tax_code") @db.VarChar(50)
  metadata      Json?

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  user        User         @relation(fields: [userId], references: [id])
  network     AgentNetwork? @relation(fields: [networkId], references: [id])
  bookings    Booking[]
  leads       Lead[]
  commissions AgentCommission[]
  documents   Document[]
  tourists    Tourist[]    @relation("TouristAgent")

  @@index([agentType])
  @@index([status])
  @@index([networkId])
  @@index([externalId])
  @@map("agents")
}

// =============================================================================
// MODEL 5: cancellation_policies
// Умови скасування бронювань (штрафи залежно від кількості днів до виїзду)
// =============================================================================
model CancellationPolicy {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  /// JSON: [{days_before: 30, penalty_pct: 0}, {days_before: 14, penalty_pct: 0.5}, {days_before: 0, penalty_pct: 1}]
  rules       Json
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  tours Tour[]

  @@map("cancellation_policies")
}

// =============================================================================
// MODEL 6: staff
// Турлідери, гіди, водії, координатори
// =============================================================================
model Staff {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String?   @unique @map("user_id") @db.Uuid
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  role            StaffRole
  phone           String?   @db.VarChar(50)
  email           String?   @db.VarChar(255)
  /// Мови спілкування: ["uk", "en", "pl"]
  languages       String[]
  /// Спеціалізація по напрямках: ["Італія", "Франція"]
  specializations String[]
  /// active | inactive
  status          String    @default("active") @db.VarChar(30)
  notes           String?   @db.Text

  // Relations
  user       User?  @relation(fields: [userId], references: [id])
  guidedTours Tour[] @relation("TourGuide")

  @@index([role])
  @@map("staff")
}

// =============================================================================
// MODEL 7: tours
// Каталог турів. Головна довідкова таблиця.
// Джерело реальних даних: собівартість_NEW.csv, AGcomission.csv, PROD_LEGEND.csv
// =============================================================================
model Tour {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Унікальний код туру: LP26010301, PN25102505 (з CSV)
  code            String    @unique @db.VarChar(20)
  name            String    @db.VarChar(255)
  /// Продуктова лінія: "Лапландія", "Вікенд у Венеції"
  product         String?   @db.VarChar(100)
  direction       String?   @db.VarChar(100)
  /// Масив країн туру
  countries       String[]
  tourType        TourType  @map("tour_type")
  /// Формат: "автобусний", "авіа", "комбінований"
  format          String?   @db.VarChar(50)
  departureDate   DateTime  @map("departure_date") @db.Date
  returnDate      DateTime  @map("return_date") @db.Date
  /// К-сть днів (з CSV: "днів")
  durationDays    Int       @map("duration_days")
  departureCity   String?   @map("departure_city") @db.VarChar(100)
  arrivalCity     String?   @map("arrival_city") @db.VarChar(100)

  // ── Комерційні поля ──────────────────────────────────────────
  /// Базова ціна туру (EUR)
  basePrice       Decimal   @map("base_price") @db.Decimal(10, 2)
  currency        String    @default("EUR") @db.Char(3)
  depositAmount   Decimal?  @map("deposit_amount") @db.Decimal(10, 2)
  depositDeadline DateTime? @map("deposit_deadline") @db.Date
  cancelPolicyId  String?   @map("cancel_policy_id") @db.Uuid
  /// Відсоток комісії агентам (з AGcomission.csv: 0.14 = 14%)
  agentCommissionPct Decimal @map("agent_commission_pct") @db.Decimal(5, 4)

  // ── Операційні поля ──────────────────────────────────────────
  totalSeats      Int       @map("total_seats")
  /// КРИТИЧНО: оновлювати тільки через транзакцію (BR-01)
  availableSeats  Int       @map("available_seats")
  status          TourStatus @default(draft)
  guideId         String?   @map("guide_id") @db.Uuid
  /// Собівартість туру (EUR) — НІКОЛИ не показувати агентам (BR-04)
  costPrice       Decimal?  @map("cost_price") @db.Decimal(10, 2)
  included        String?   @db.Text
  notIncluded     String?   @map("not_included") @db.Text

  // ── Маркетингові поля ──────────────────────────────────────────
  tags            String[]
  audience        String?   @db.VarChar(100)
  difficulty      String?   @db.VarChar(50)
  isFamily        Boolean   @default(false) @map("is_family")
  isPremium       Boolean   @default(false) @map("is_premium")
  isCorporate     Boolean   @default(false) @map("is_corporate")
  isFirstExperience Boolean @default(false) @map("is_first_experience")

  // ── Фінансова звітність ──────────────────────────────────────
  /// Посилання на Asana task (міграція з CSV)
  asanaLink       String?   @map("asana_link") @db.Text

  // ── Zoho CRM Integration ─────────────────────────────────────
  externalId    String?   @unique @map("external_id") @db.VarChar(100)
  imageUrl      String?   @map("image_url") @db.Text
  sortOrder     Int       @default(0) @map("sort_order")
  metadata      Json?

  isArchived      Boolean   @default(false) @map("is_archived")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  cancelPolicy    CancellationPolicy? @relation(fields: [cancelPolicyId], references: [id])
  guide           Staff?              @relation("TourGuide", fields: [guideId], references: [id])
  bookings        Booking[]
  leads           Lead[]
  hotelBookings   HotelBooking[]
  transports      TransportBooking[]
  activities      TourActivity[]
  extras          TourExtra[]
  documents       Document[]

  @@index([status])
  @@index([departureDate])
  @@index([code])
  @@index([isArchived])
  @@index([tourType])
  @@index([externalId])
  @@map("tours")
}

// =============================================================================
// MODEL 8: leads
// CRM — всі вхідні звернення. Канали: сайт, Instagram, Telegram, агенти тощо.
// =============================================================================
model Lead {
  id                   String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Може не мати Tourist-профілю (новий лід)
  touristId            String?     @map("tourist_id") @db.Uuid
  managerId            String      @map("manager_id") @db.Uuid
  tourId               String?     @map("tour_id") @db.Uuid
  agentId              String?     @map("agent_id") @db.Uuid
  source               LeadSource
  status               LeadStatus  @default(new)
  interestNote         String?     @map("interest_note") @db.Text
  budget               Decimal?    @db.Decimal(10, 2)
  personsCount         Int?        @map("persons_count")
  nextActionAt         DateTime?   @map("next_action_at")
  lossReason           String?     @map("loss_reason") @db.VarChar(255)
  notes                String?     @db.Text
  /// Встановлюється після конвертації в бронювання
  convertedToBookingId String?     @unique @map("converted_to_booking_id") @db.Uuid

  // ── Zoho CRM Integration ─────────────────────────────────────
  externalId  String?     @unique @map("external_id") @db.VarChar(100)
  metadata    Json?

  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  // Relations
  tourist    Tourist?  @relation(fields: [touristId], references: [id])
  manager    User      @relation("LeadManager", fields: [managerId], references: [id])
  tour       Tour?     @relation(fields: [tourId], references: [id])
  agent      Agent?    @relation(fields: [agentId], references: [id])
  booking    Booking?  @relation("LeadBooking", fields: [convertedToBookingId], references: [id])

  @@index([status])
  @@index([managerId])
  @@index([source])
  @@index([createdAt])
  @@index([externalId])
  @@map("leads")
}

// =============================================================================
// MODEL 9: bookings
// ЦЕНТРАЛЬНА ТАБЛИЦЯ СИСТЕМИ. Від нової заявки до завершення туру.
// Формат номера: ET-YYYY-NNNNN
// =============================================================================
model Booking {
  id                   String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Унікальний номер бронювання: ET-2025-00123
  bookingNumber        String               @unique @map("booking_number") @db.VarChar(30)
  tourId               String               @map("tour_id") @db.Uuid
  leadId               String?              @map("lead_id") @db.Uuid
  bookingType          BookingType          @map("booking_type")
  /// Контактна особа по бронюванню
  contactTouristId     String               @map("contact_tourist_id") @db.Uuid
  managerId            String               @map("manager_id") @db.Uuid
  agentId              String?              @map("agent_id") @db.Uuid
  personsCount         Int                  @map("persons_count")

  // ── Фінансові поля ──────────────────────────────────────────
  /// Загальна сума бронювання (EUR)
  totalAmount          Decimal              @map("total_amount") @db.Decimal(10, 2)
  depositAmount        Decimal              @map("deposit_amount") @db.Decimal(10, 2)
  depositPaid          Decimal              @default(0) @map("deposit_paid") @db.Decimal(10, 2)
  depositDeadline      DateTime?            @map("deposit_deadline") @db.Date
  balanceAmount        Decimal              @map("balance_amount") @db.Decimal(10, 2)
  balancePaid          Decimal              @default(0) @map("balance_paid") @db.Decimal(10, 2)
  balanceDeadline      DateTime?            @map("balance_deadline") @db.Date
  currency             String               @default("EUR") @db.Char(3)
  paymentStatus        BookingPaymentStatus @default(unpaid) @map("payment_status")

  // ── Статус бронювання ──────────────────────────────────────────
  status               BookingStatus        @default(new)

  // ── Комісія агента ──────────────────────────────────────────
  /// Нарахована сума комісії агенту (EUR). NULL якщо direct-бронювання
  agentCommissionRate  Decimal?             @map("agent_commission_rate") @db.Decimal(5, 4)
  agentCommissionAmount Decimal?            @map("agent_commission_amount") @db.Decimal(10, 2)
  commissionStatus     CommissionStatus?    @map("commission_status")

  sourceChannel        String?              @map("source_channel") @db.VarChar(100)
  comment              String?              @db.Text
  cancelReason         String?              @map("cancel_reason") @db.Text
  cancelledAt          DateTime?            @map("cancelled_at")

  // ── Zoho CRM Integration ─────────────────────────────────────
  adultsCount         Int?      @map("adults_count")
  childrenCount       Int       @default(0) @map("children_count")
  childrenDetails     String?   @map("children_details") @db.Text
  pickupPoint         String?   @map("pickup_point") @db.VarChar(100)
  specialRequirements String?   @map("special_requirements") @db.Text
  contractNumber      String?   @map("contract_number") @db.VarChar(50)
  exchangeRate        Decimal?  @map("exchange_rate") @db.Decimal(10, 4)
  utmSource           String?   @map("utm_source") @db.VarChar(100)
  utmCampaign         String?   @map("utm_campaign") @db.VarChar(100)
  utmContent          String?   @map("utm_content") @db.VarChar(100)
  utmTerm             String?   @map("utm_term") @db.VarChar(100)
  adKeyword           String?   @map("ad_keyword") @db.VarChar(200)
  leadSource          String?   @map("lead_source") @db.VarChar(100)
  externalId          String?   @unique @map("external_id") @db.VarChar(100)
  metadata            Json?

  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  // Relations
  tour           Tour             @relation(fields: [tourId], references: [id])
  lead           Lead?            @relation("LeadBooking")
  contactTourist Tourist          @relation("BookingContact", fields: [contactTouristId], references: [id])
  manager        User             @relation("BookingManager", fields: [managerId], references: [id])
  agent          Agent?           @relation(fields: [agentId], references: [id])
  participants   BookingTourist[]
  payments       Payment[]
  commissions    AgentCommission[]
  documents      Document[]
  communications Communication[]

  @@index([status])
  @@index([tourId])
  @@index([agentId])
  @@index([managerId])
  @@index([bookingType])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([externalId])
  @@map("bookings")
}

// =============================================================================
// MODEL 10: booking_tourists
// M:N між bookings і tourists.
// Розсадка в автобусі + тип кімнати (з CSV: Бронь_готелів)
// OPS-01/OPS-03: додано 6 полів румінгу та self-service туриста
// =============================================================================
model BookingTourist {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId    String    @map("booking_id") @db.Uuid
  touristId    String    @map("tourist_id") @db.Uuid
  /// contact = контактна особа, participant = учасник
  role         String    @default("participant") @db.VarChar(20)
  /// Рядкова мітка місця (напр. "14A") — для відображення
  seatNumber   String?   @map("seat_number") @db.VarChar(20)
  /// Поточний підтверджений тип кімнати
  roomType     RoomType? @map("room_type")
  /// Індивідуальна ціна для цього учасника (EUR)
  price        Decimal?  @db.Decimal(10, 2)
  specialNotes String?   @map("special_notes") @db.Text

  // ── OPS-03: Self-service туриста — побажання ──────────────────────────────
  /// Бажаний тип номеру (турист обирає сам). НЕ гарантія — фінальне рішення за продактом
  preferredRoomType  RoomType? @map("preferred_room_type")
  /// Номер місця в автобусі (1..total_seats). NULL = немає переваги.
  /// UNIQUE в межах бронювання — перевірка на рівні БД + SELECT FOR UPDATE у сервісі
  busSeaNumber       Int?      @map("bus_seat_number")

  // ── OPS-01: Фактичне розміщення після затвердження румінгу ───────────────
  /// Фактичний номер кімнати в готелі (проставляє ops після затвердження)
  actualRoomNumber   String?   @map("actual_room_number") @db.VarChar(20)
  /// Фактичний тип номеру (може відрізнятись від preferred)
  actualRoomType     RoomType? @map("actual_room_type")

  // ── OPS-03: Додаткові побажання ───────────────────────────────────────────
  /// Побажання по сусіду — free-text, контролюється менеджером
  roommatePreference String?   @map("roommate_preference") @db.Text
  /// Алергії, медичні обмеження, VIP — бачить ops та турлідер
  specialRequirements String?  @map("special_requirements") @db.Text

  // Relations
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tourist  Tourist @relation(fields: [touristId], references: [id])

  @@unique([bookingId, touristId])
  /// OPS-03: місце в автобусі унікальне в межах бронювання.
  /// NULL не порушує UNIQUE в PostgreSQL (кілька туристів можуть мати NULL)
  @@unique([bookingId, busSeaNumber])
  @@index([bookingId])
  @@index([touristId])
  @@map("booking_tourists")
}

// =============================================================================
// MODEL 11: payments
// Кожна транзакція — окремий запис.
// Депозити, доплати, повернення, виплати комісій.
// =============================================================================
model Payment {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId     String        @map("booking_id") @db.Uuid
  touristId     String?       @map("tourist_id") @db.Uuid
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("EUR") @db.Char(3)
  /// Курс EUR/UAH на момент оплати (з CSV Транспорт: курс)
  exchangeRate  Decimal?      @map("exchange_rate") @db.Decimal(8, 4)
  paymentType   PaymentType   @map("payment_type")
  paymentMethod PaymentMethod? @map("payment_method")
  status        PaymentStatus @default(pending)
  paidAt        DateTime?     @map("paid_at")
  dueDate       DateTime?     @map("due_date") @db.Date
  /// Номер транзакції / чека
  reference     String?       @db.VarChar(100)
  confirmedById String?       @map("confirmed_by_id") @db.Uuid
  notes         String?       @db.Text

  // ── Zoho CRM Integration ─────────────────────────────────────
  externalId    String?       @unique @map("external_id") @db.VarChar(100)
  metadata      Json?

  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  booking     Booking @relation(fields: [bookingId], references: [id])
  tourist     Tourist? @relation(fields: [touristId], references: [id])
  confirmedBy User?   @relation("PaymentConfirmer", fields: [confirmedById], references: [id])

  @@index([bookingId])
  @@index([status])
  @@index([paymentType])
  @@index([paidAt])
  @@index([externalId])
  @@map("payments")
}

// =============================================================================
// MODEL 12: agent_commissions
// Детальний облік комісій агентів. Окремо від bookings для можливості часткових виплат.
// Синхронізовано з frontend CommissionStatus (5 значень)
// =============================================================================
model AgentCommission {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bookingId      String          @map("booking_id") @db.Uuid
  agentId        String          @map("agent_id") @db.Uuid
  /// Загальна комісія (EUR)
  grossAmount    Decimal         @map("gross_amount") @db.Decimal(10, 2)
  /// Сума до виплати агенту (після вирахування ЦО та роялті для network)
  agentAmount    Decimal         @map("agent_amount") @db.Decimal(10, 2)
  /// Сума ЦО мережі (NULL для standard)
  coAmount       Decimal?        @map("co_amount") @db.Decimal(10, 2)
  /// Сума роялті (NULL для standard)
  royaltyAmount  Decimal?        @map("royalty_amount") @db.Decimal(10, 2)
  commissionRate Decimal         @map("commission_rate") @db.Decimal(5, 4)
  status         CommissionStatus @default(pending)
  /// Дата виплати агенту
  paidAt         DateTime?       @map("paid_at")
  notes          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id])
  agent   Agent   @relation(fields: [agentId], references: [id])

  @@unique([bookingId, agentId])
  @@index([agentId])
  @@index([status])
  @@map("agent_commissions")
}

// =============================================================================
// MODEL 13: hotels
// База готелів. Джерело: Final_Hotel_Database__Sheet1.csv (563 готелі)
// =============================================================================
model Hotel {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Hotel ID з CSV (для міграції)
  hotelExternalId   Float?    @map("hotel_external_id")
  name              String    @db.VarChar(255)
  country           String    @db.VarChar(100)
  city              String    @db.VarChar(100)
  address           String?   @db.Text
  zip               String?   @db.VarChar(20)
  district          String?   @db.VarChar(100)
  accommodationType String?   @map("accommodation_type") @db.VarChar(100)
  stars             Decimal?  @db.Decimal(2, 1)
  reviewScore       Decimal?  @map("review_score") @db.Decimal(3, 1)
  reviewCount       Int?      @map("review_count")
  distanceFromCentre Decimal? @map("distance_from_centre") @db.Decimal(5, 2)
  latitude          Decimal?  @db.Decimal(10, 7)
  longitude         Decimal?  @db.Decimal(10, 7)

  // ── Ціни (EUR/ніч) ──────────────────────────────────────────
  priceApr          Decimal?  @map("price_apr") @db.Decimal(8, 2)
  priceJun          Decimal?  @map("price_jun") @db.Decimal(8, 2)
  priceOct          Decimal?  @map("price_oct") @db.Decimal(8, 2)

  // ── Контакти ──────────────────────────────────────────────────
  email             String?   @db.VarChar(255)
  phone             String?   @db.VarChar(50)
  bookingUrl        String?   @map("booking_url") @db.Text
  website           String?   @db.Text

  // ── Характеристики ──────────────────────────────────────────
  facilities        String?   @db.Text
  languagesSpoken   String?   @map("languages_spoken") @db.VarChar(100)
  isFamilyFriendly  Boolean   @default(false) @map("is_family_friendly")
  breakfastScore    Decimal?  @map("breakfast_score") @db.Decimal(3, 1)
  wifiScore         Decimal?  @map("wifi_score") @db.Decimal(3, 1)
  avgRoomSizeM2     Decimal?  @map("avg_room_size_m2") @db.Decimal(5, 1)

  isVerified        Boolean   @default(false) @map("is_verified")
  /// active | inactive | archived
  status            String    @default("active") @db.VarChar(30)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  hotelBookings HotelBooking[]

  @@index([country, city])
  @@index([status])
  @@map("hotels")
}

// =============================================================================
// MODEL 14: hotel_bookings
// Бронювання готелів по конкретних турах.
// Джерело: Бронь_готелів.csv (2577 записів)
// OPS-01/OPS-02/OPS-03: додано 14 полів румінгу та нотифікацій
// =============================================================================
model HotelBooking {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tourId              String    @map("tour_id") @db.Uuid
  hotelId             String    @map("hotel_id") @db.Uuid
  city                String    @db.VarChar(100)
  checkInDate         DateTime  @map("check_in_date") @db.Date
  nightsCount         Int       @map("nights_count")
  /// Бюджет план за ніч (EUR)
  budgetPerNight      Decimal?  @map("budget_per_night") @db.Decimal(8, 2)

  // ── Ціни по типах кімнат (EUR/особу/ніч) ──────────────────
  priceTwin           Decimal?  @map("price_twin") @db.Decimal(8, 2)
  qtyTwin             Int?      @map("qty_twin")
  priceDbl            Decimal?  @map("price_dbl") @db.Decimal(8, 2)
  qtyDbl              Int?      @map("qty_dbl")
  priceTrpl           Decimal?  @map("price_trpl") @db.Decimal(8, 2)
  qtyTrpl             Int?      @map("qty_trpl")
  priceSngl           Decimal?  @map("price_sngl") @db.Decimal(8, 2)
  qtySngl             Int?      @map("qty_sngl")
  discountEur         Decimal?  @map("discount_eur") @db.Decimal(8, 2)

  personsCountActual  Int?      @map("persons_count_actual")
  totalCost           Decimal?  @map("total_cost") @db.Decimal(10, 2)
  depositAmount       Decimal?  @map("deposit_amount") @db.Decimal(10, 2)
  depositStatus       String?   @map("deposit_status") @db.VarChar(50)
  balanceAmount       Decimal?  @map("balance_amount") @db.Decimal(10, 2)
  /// active | confirmed | cancelled | archived
  status              String    @default("active") @db.VarChar(30)
  optionDeadline      DateTime? @map("option_deadline") @db.Date
  roomingDeadline     DateTime? @map("rooming_deadline") @db.Date
  confirmationStatus  String?   @map("confirmation_status") @db.VarChar(100)
  source              String?   @db.VarChar(100)
  cityTaxIncluded     Boolean   @default(false) @map("city_tax_included")
  factAmountEur       Decimal?  @map("fact_amount_eur") @db.Decimal(10, 2)
  notes               String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // ── OPS-01: Стандартна структура номерів ──────────────────────────────────
  /// К-сть TWIN за стандартною структурою заїзду (OPS-01)
  plannedTwin              Int           @default(0) @map("planned_twin")
  /// К-сть DOUBLE (двоспальне ліжко) (OPS-01)
  plannedDouble            Int           @default(0) @map("planned_double")
  /// К-сть TRIPLE (тримісних) (OPS-01)
  plannedTriple            Int           @default(0) @map("planned_triple")
  /// К-сть SINGLE (одномісних) — контроль рентабельності (OPS-01)
  plannedSingle            Int           @default(0) @map("planned_single")

  // ── OPS-01: Статусна машина румінгу ──────────────────────────────────────
  /// DRAFT→APPROVED→FINAL. Блокує зміни структури після APPROVED (тільки admin)
  structureStatus          RoomingStatus @default(draft) @map("structure_status")
  /// FK → users.id — продакт, який затвердив структуру (OPS-01)
  structureApprovedBy      String?       @map("structure_approved_by") @db.Uuid
  /// Час затвердження структури (OPS-01)
  structureApprovedAt      DateTime?     @map("structure_approved_at")

  // ── OPS-02: Автонотифікації BullMQ ───────────────────────────────────────
  /// Час надсилання тригерної нотифікації (для дедуплікації — не слати двічі)
  roomingTriggerSentAt     DateTime?     @map("rooming_trigger_sent_at")
  /// BullMQ виставляє true після тригера (30 туристів АБО 14 днів до старту)
  opsRoomingRequired       Boolean       @default(false) @map("ops_rooming_required")

  // ── OPS-02/OPS-03: Прапорці виконання румінгу ────────────────────────────
  /// Попередній румінг виконано (менеджер закриває чекліст)
  preliminaryRoomingDone   Boolean       @default(false) @map("preliminary_rooming_done")
  /// Дата виконання попереднього румінгу
  preliminaryRoomingAt     DateTime?     @map("preliminary_rooming_at")
  /// Фінальний румінг закрито — після цього self-service туриста вимкнено (OPS-03)
  finalRoomingDone         Boolean       @default(false) @map("final_rooming_done")
  /// Дата закриття фінального румінгу (дедлайн ≤ 5 днів до старту туру)
  finalRoomingAt           DateTime?     @map("final_rooming_at")
  /// High season: тур запущено за тиждень — структура одразу фінальна, нотифікація не надсилається
  isFastLaunch             Boolean       @default(false) @map("is_fast_launch")

  // Relations
  tour                Tour  @relation(fields: [tourId], references: [id])
  hotel               Hotel @relation(fields: [hotelId], references: [id])
  structureApprover   User? @relation("HotelBookingApprover", fields: [structureApprovedBy], references: [id])

  @@index([tourId])
  @@index([hotelId])
  @@index([status])
  /// OPS-02: BullMQ scheduler — ефективний запит "всіх турів, де потрібен румінг"
  @@index([structureStatus, opsRoomingRequired])
  /// OPS-02: Дедуплікація нотифікацій — перевірка чи вже надсилалось цього тижня
  @@index([roomingTriggerSentAt])
  @@map("hotel_bookings")
}

// =============================================================================
// MODEL 15: transport_bookings
// Транспортні бронювання по турах.
// Джерела: Транспорт.csv + calculator_transport.csv
// =============================================================================
model TransportBooking {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tourId            String    @map("tour_id") @db.Uuid
  transportType     String    @map("transport_type") @db.VarChar(50)
  connectionType    String?   @map("connection_type") @db.VarChar(50)
  carrierName       String?   @map("carrier_name") @db.VarChar(255)
  busBrand          String?   @map("bus_brand") @db.VarChar(100)
  departureDate     DateTime? @map("departure_date") @db.Date
  returnDate        DateTime? @map("return_date") @db.Date

  // ── Кілометраж ──────────────────────────────────────────────
  /// Кілометраж Google (основний маршрут)
  kmGoogle          Decimal?  @map("km_google") @db.Decimal(8, 1)
  /// Допи план км (екскурсійні виїзди)
  kmExtras          Decimal?  @map("km_extras") @db.Decimal(8, 1)
  kmTotalPlan       Decimal?  @map("km_total_plan") @db.Decimal(8, 1)
  kmTotalFact       Decimal?  @map("km_total_fact") @db.Decimal(8, 1)
  ratePerKm         Decimal?  @map("rate_per_km") @db.Decimal(6, 4)

  // ── Вартість ──────────────────────────────────────────────────
  /// Паливний збір (EUR, з calculator_transport.csv)
  fuelSurcharge     Decimal?  @map("fuel_surcharge") @db.Decimal(8, 2)
  costPlan          Decimal?  @map("cost_plan") @db.Decimal(10, 2)
  costFact          Decimal?  @map("cost_fact") @db.Decimal(10, 2)
  paidAdvanceEur    Decimal?  @map("paid_advance_eur") @db.Decimal(10, 2)
  paidCashEur       Decimal?  @map("paid_cash_eur") @db.Decimal(10, 2)
  balanceEur        Decimal?  @map("balance_eur") @db.Decimal(10, 2)
  exchangeRate      Decimal?  @map("exchange_rate") @db.Decimal(8, 4)
  balanceUah        Decimal?  @map("balance_uah") @db.Decimal(12, 2)

  // ── Розсадка ──────────────────────────────────────────────────
  /// JSON: схема розсадки автобуса [{seat: "1A", tourist_id: "...", name: "..."}, ...]
  seatingPlan       Json?     @map("seating_plan")

  wifiOrDeliveryFee Decimal?  @map("wifi_or_delivery_fee") @db.Decimal(8, 2)
  /// planned | confirmed | completed | cancelled
  status            String    @default("planned") @db.VarChar(30)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  tour Tour @relation(fields: [tourId], references: [id])

  @@index([tourId])
  @@index([status])
  @@map("transport_bookings")
}

// =============================================================================
// MODEL 16: tour_activities
// Екскурсії, активності, заходи по турах.
// Джерело: Бронювання_активностей.csv (4341 запис)

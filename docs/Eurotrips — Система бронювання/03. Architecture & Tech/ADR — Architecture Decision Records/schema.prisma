  tourId           String    @map("tour_id") @db.Uuid
  connectionType   String?   @map("connection_type") @db.VarChar(50)
  guideCost        Decimal?  @map("guide_cost") @db.Decimal(8, 2)
  parkingCost      Decimal?  @map("parking_cost") @db.Decimal(8, 2)
  cityEntriesCost  Decimal?  @map("city_entries_cost") @db.Decimal(8, 2)
  giftsCost        Decimal?  @map("gifts_cost") @db.Decimal(8, 2)
  insuranceCost    Decimal?  @map("insurance_cost") @db.Decimal(8, 2)
  otherCost        Decimal?  @map("other_cost") @db.Decimal(8, 2)
  /// Загальна сума ДОПів (з CSV: sum)
  totalCost        Decimal?  @map("total_cost") @db.Decimal(8, 2)
  personsCount     Int?      @map("persons_count")
  /// відбувся | відмінено | planned
